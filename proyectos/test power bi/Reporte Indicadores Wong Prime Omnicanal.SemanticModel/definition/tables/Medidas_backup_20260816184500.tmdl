	measure VALOR_PRIME_SEMANA = ```
			
			SWITCH(
			    SELECTEDVALUE(Indicadores_prime[Etiqueta]),
			
			    // 1. Venta Neta
			    "1- Venta Neta", 
			        CALCULATE(
			                SUM(prime_indicadores_semana_grupos[venta_neta]), 
			                prime_indicadores_semana_grupos[grupo] = "PRIME"
			            ),
			            "#,0"
			        ),
			
			    // 2. % Part. Vta Prime/Wong
			    "2- %Part. Vta Prime/Wong",
			        VAR vtaPrime = CALCULATE(
			            SUM(prime_indicadores_semana_grupos[venta_neta]), 
			            prime_indicadores_semana_grupos[grupo] = "PRIME"
			        )
			        VAR vtaTotal = SUM(prime_indicadores_semana_total[venta_neta])
			        RETURN FORMAT(DIVIDE(vtaPrime, vtaTotal),
			
			    // 3. Nº Transacciones
			    "3- Nº Transacciones", 
			        CALCULATE(
			                SUM(prime_indicadores_semana_grupos[trx]), 
			                prime_indicadores_semana_grupos[grupo] = "PRIME"
			            ),
			            "#,0"
			        ),
			
			    // 4. %Part. Trx Prime/Wong
			    "4- %Part. Trx Prime/Wong",
			        VAR trxPrime = CALCULATE(
			            SUM(prime_indicadores_semana_grupos[trx]), 
			            prime_indicadores_semana_grupos[grupo] = "PRIME"
			        )
			        VAR trxTotal = SUM(prime_indicadores_semana_total[trx])
			        RETURN FORMAT(DIVIDE(trxPrime, trxTotal),
			
			    // 5. Nº Clientes
			    "5- Nº Clientes", 
			        CALCULATE(
			                SUM(prime_indicadores_semana_grupos[clientes]), 
			                prime_indicadores_semana_grupos[grupo] = "PRIME"
			            ),
			            "#,0"
			        ),
			
			    // 6. %Part. Clientes Prime/Wong
			    "6- %Part. Clientes Prime/Wong",
			        VAR cliPrime = CALCULATE(
			            SUM(prime_indicadores_semana_grupos[clientes]), 
			            prime_indicadores_semana_grupos[grupo] = "PRIME"
			        )
			        VAR cliTotal = cliPrime + CALCULATE(
			            SUM(prime_indicadores_semana_grupos[clientes]), 
			            prime_indicadores_semana_grupos[grupo] = "NO PRIME"
			        )
			        RETURN FORMAT(DIVIDE(cliPrime, cliTotal),
			
			    // 7. Gasto Promedio Bruto
			    "7- Gasto Promedio Bruto", 
			        CALCULATE(
			                AVERAGE(prime_indicadores_semana_grupos[gasto_prom]), 
			                prime_indicadores_semana_grupos[grupo] = "PRIME"
			            ),
			            "#,0"
			        ),
			
			    // 8. Frecuencia
			    "8- Frecuencia", 
			        FORMAT(
			            CALCULATE(
			                AVERAGE(prime_indicadores_semana_grupos[frecuencia]), 
			                prime_indicadores_semana_grupos[grupo] = "PRIME"
			            ),
			            "#,0.00"
			        ),
			
			    // 9. Ticket Promedio Bruto
			    "9- Ticket Promedio Bruto", 
			        FORMAT(
			            CALCULATE(
			                AVERAGE(prime_indicadores_semana_grupos[tkp]), 
			                prime_indicadores_semana_grupos[grupo] = "PRIME"
			            ),
			            "#,0.0"
			        ),
			
			    // 10. Vta Neta Promocional (Punto Precio)
			    "9.1- Vta Neta Promocional (Punto Precio)", 
			        FORMAT(SUM(promocional_semana[venta_neta_promocional]),
			
			    // 11. % Part. Vta Neta Promocional
			    "9.2- % Part. Vta Neta Promocional", 
			        VAR vtaPromo = SUM(promocional_semana[venta_neta_promocional])
			        VAR vtaNetaTotal = CALCULATE(
			            SUM(prime_indicadores_semana_grupos[venta_neta]), 
			            prime_indicadores_semana_grupos[grupo] = "PRIME"
			        )
			        RETURN DIVIDE(vtaPromo, vtaNetaTotal),
			
			    // 12. Clientes Promocional
			    "9.3- Clientes Promocional",
			        SUM(promocional_semana[clientes_promocional]),
			
			    // 13. % Clientes Promocional
			    "9.4- % Clientes Promocional",
			        VAR cliPromo = SUM(promocional_semana[clientes_promocional])
			        VAR cliTotal2 = CALCULATE(
			            SUM(prime_indicadores_semana_grupos[clientes]), 
			            prime_indicadores_semana_grupos[grupo] = "PRIME"
			        )
			        RETURN DIVIDE(cliPromo, cliTotal2),
			
			    // 14. Dscto Bruto Promocional
			    "9.5- Dscto Bruto Promocional",
			        SUM(promocional_semana[dsct_bruto_promocional])
			)
			
			```
