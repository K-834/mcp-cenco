table Selector_Metrica
	lineageTag: acbed752-a571-4942-a2e0-3ce8358c54a7

	measure 'Valor Seleccionado' = ```
			
			VAR seleccion = SELECTEDVALUE('Selector_Metrica'[Métrica])
			RETURN
			    SWITCH(
			        seleccion,
			        "Venta Neta",      SUM(prime_indicadores_mes_grupos[venta_neta]),
			        "Margen",          SUM(prime_indicadores_mes_grupos[margen]),
			        "Clientes",        SUM(prime_indicadores_mes_grupos[clientes]),
			        "Unidades",        SUM(prime_indicadores_mes_grupos[unidades]),
			        "Frecuencia",      AVERAGE(prime_indicadores_mes_grupos[frecuencia]),
			        "Gasto Prom",      AVERAGE(prime_indicadores_mes_grupos[gasto_prom]),
			        "TKP",             AVERAGE(prime_indicadores_mes_grupos[tkp]),
			        "Transacciones",   SUM(prime_indicadores_mes_grupos[trx]),
			        BLANK()
			    )
			
			```
		lineageTag: 3874641d-41ed-4942-8e55-2035bdeb1c55

		annotation PBI_FormatHint = {"isGeneralNumber":true}

