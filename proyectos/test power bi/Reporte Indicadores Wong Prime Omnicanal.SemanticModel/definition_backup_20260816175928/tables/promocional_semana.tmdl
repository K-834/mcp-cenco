	partition promocional_semana = m
		mode: import
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("dl-prod.ctk5g1p1sube.us-east-1.redshift.amazonaws.com:5439","datalabs"), "select cast(semana as bigint) as semana, (cast(semana as varchar(50)) || '-Ecommerce') as clave_semana, cast(dsct_bruto_promocional as double precision) as dsct_bruto_promocional, cast(clientes_promocional as bigint) as clientes_promocional, cast(venta_neta_promocional as double precision) as venta_neta_promocional, 'Ecommerce' as canal from dl_sp_temporal.promotion_semana union all select cast(semana as bigint) as semana, (cast(semana as varchar(50)) || '-Piso') as clave_semana, cast(dsct_bruto_promocional as double precision) as dsct_bruto_promocional, cast(clientes as bigint) as clientes_promocional, cast(venta_neta_promocional as double precision) as venta_neta_promocional, 'Piso' as canal from dl_sp_dashboards_ecommerce.promocion_prime_piso_semana union all select cast(semana as bigint) as semana, (cast(semana as varchar(50)) || '-Totales') as clave_semana, cast(dsct_bruto_promocional as double precision) as dsct_bruto_promocional, cast(clientes as bigint) as clientes_promocional, cast(venta_neta_promocional as double precision) as venta_neta_promocional, 'Totales' as canal from dl_sp_dashboards_ecommerce.promocion_prime_omnicanal_semana", null, [EnableFolding=true]),
				    #"Filas ordenadas" = Table.Sort(Origen,{{"semana", Order.Descending}})
				in
				    #"Filas ordenadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

