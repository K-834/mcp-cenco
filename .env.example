# Plantilla de variables de entorno.
#
# Copia este archivo a `.env` (NO commitear `.env`) y completa los valores:
#     copy .env.example .env       # Windows
#     cp .env.example .env         # Linux/macOS
#
# `scripts/run.py` carga `.env` automaticamente al inicio. Las env vars ya seteadas
# en el shell tienen prioridad sobre las de `.env` (asi podes override temporal).
#
# Tratar como secretos — no commitear `.env`, esta plantilla `.env.example` SI.

# ─── LLM: provedores cloud (deja comentados los que no uses) ───

# Google Gemini / Gemma (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# MiniMax (https://api.minimax.io) — modelos: MiniMax-M2.1, MiniMax-M2.5, MiniMax-M3
MINIMAX_API_KEY=
# MINIMAX_API_BASE=https://api.minimax.io/v1   # default
# MINIMAX_USE_CHINA=1                          # uncomment para endpoint China

# ─── LLM: Ollama local (gratis, sin API key) ───

# Ollama corre por defecto en localhost:11434. Solo cambia si esta en otra maquina/puerto.
# OLLAMA_API_BASE=http://localhost:11434

# ─── LLM: configuracion del extractor (opcional, defaults razonables) ───

# Modelo a usar. Si esta vacio, usa el default del proyecto (Ollama local si esta disponible).
# POWERBI_MCP_LLM_MODEL=ollama/gemma3:4b

# Timeout por trozo del documento en segundos (default 180).
# POWERBI_MCP_LLM_TIMEOUT=180

# Tokens maximos de respuesta por trozo (default 3000).
# POWERBI_MCP_LLM_MAX_TOKENS=3000

# Contexto de Ollama por trozo (default 4096). Subir si tu maquina tiene RAM de sobra.
# POWERBI_MCP_LLM_NUM_CTX=4096

# ─── Otros (no LLM, ya existentes) ───

# Redshift (no tocar si no usas esta BD)
# REDSHIFT_HOST=
# REDSHIFT_PORT=5439
# REDSHIFT_DATABASE=
# REDSHIFT_USER=
# REDSHIFT_PASSWORD=
# REDSHIFT_SCHEMA=
