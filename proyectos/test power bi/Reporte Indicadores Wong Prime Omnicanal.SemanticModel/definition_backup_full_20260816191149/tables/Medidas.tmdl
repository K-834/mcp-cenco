table Medidas_BestPractices
	lineageTag: autogenerated-best-practices

	-- Numeric measures for Prime (Month)
	measure Vta_Neta_Prime_Mes =
		CALCULATE(SUM(prime_indicadores_mes_grupos[venta_neta]), prime_indicadores_mes_grupos[grupo] = "PRIME")

	formatString: "#,0"

	measure Vta_Neta_Total_Mes =
		SUM(prime_indicadores_mes_total[venta_neta])

	formatString: "#,0"

	measure %Part_Vta_Prime_vs_Total =
		DIVIDE([Vta_Neta_Prime_Mes], [Vta_Neta_Total_Mes])
	formatString: "0.0%"
	measure Trx_Prime_Mes =
		CALCULATE(SUM(prime_indicadores_mes_grupos[trx]), prime_indicadores_mes_grupos[grupo] = "PRIME")

	formatString: "#,0"

	measure Trx_Total_Mes =
		SUM(prime_indicadores_mes_total[trx])

	formatString: "#,0"

	measure %Part_Trx_Prime_vs_Total =
		DIVIDE([Trx_Prime_Mes], [Trx_Total_Mes])

	formatString: "0.0%"

	measure Clientes_Prime_Mes =
		CALCULATE(SUM(prime_indicadores_mes_grupos[clientes]), prime_indicadores_mes_grupos[grupo] = "PRIME")

	formatString: "#,0"

	measure Clientes_Total_Mes =
		CALCULATE(SUM(prime_indicadores_mes_grupos[clientes]), prime_indicadores_mes_grupos[grupo] = "PRIME") + CALCULATE(SUM(prime_indicadores_mes_grupos[clientes]), prime_indicadores_mes_grupos[grupo] = "NO PRIME")

	formatString: "#,0"

	measure %Part_Clientes_Prime_vs_Total =
		DIVIDE([Clientes_Prime_Mes], [Clientes_Total_Mes])

	formatString: "0.0%"

	measure Gasto_Promedio_Bruto_Prime_Mes =
		CALCULATE(AVERAGE(prime_indicadores_mes_grupos[gasto_prom]), prime_indicadores_mes_grupos[grupo] = "PRIME")

	formatString: "#,0"

	measure Frecuencia_Prime_Mes =
		CALCULATE(AVERAGE(prime_indicadores_mes_grupos[frecuencia]), prime_indicadores_mes_grupos[grupo] = "PRIME")

	-- Week equivalents (if week tables exist)
	measure Vta_Neta_Prime_Semana =
		CALCULATE(SUM(prime_indicadores_semana_grupos[venta_neta]), prime_indicadores_semana_grupos[grupo] = "PRIME")

	formatString: "#,0"

	measure Vta_Neta_Total_Semana =
		SUM(prime_indicadores_semana_total[venta_neta])

	formatString: "#,0"

	measure %Part_Vta_Prime_vs_Total_Sem =
		DIVIDE([Vta_Neta_Prime_Semana], [Vta_Neta_Total_Semana])

	-- Utility measures
	formatString: "0.0%"
	measure Ultima_Actualizacion =
		MAX(Actualizacion[Fecha])

	formatString: "yyyy-mm-dd"

	measure Selected_Value =
		SELECTEDVALUE(Selector_Metrica[Valor], BLANK())

	annotations:
		-- format suggestions (apply in model):
		-- Vta_Neta_* : "#,0"
		-- %Part_* : "0.0%"
		-- Trx_* : "#,0"
		-- Clientes_* : "#,0"
		-- Gasto_Promedio_Bruto_* : "#,0"
