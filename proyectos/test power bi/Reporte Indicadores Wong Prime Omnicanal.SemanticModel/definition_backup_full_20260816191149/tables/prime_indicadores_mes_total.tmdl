	partition prime_indicadores_mes_total = m
		mode: import
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("dl-prod.ctk5g1p1sube.us-east-1.redshift.amazonaws.com:5439","datalabs"), "select cast(mes as varchar(50)) as mes, (cast(mes as varchar(50)) || '-Ecommerce') as clave_mes, cast(clientes as bigint) as clientes, cast(venta_bruta as double precision) as venta_bruta, cast(trx as bigint) as trx, cast(unidades as double precision) as unidades, cast(venta_neta as double precision) as venta_neta, cast(margen as double precision) as margen, cast(gasto_prom as double precision) as gasto_prom, cast(frecuencia as double precision) as frecuencia, cast(tkp as double precision) as tkp, cast(unid_ticket as double precision) as unid_ticket, cast(precio_prom as double precision) as precio_prom, cast(margen_por as double precision) as margen_por, 'Ecommerce' as canal from dl_sp_dashboards_ecommerce.prime_indicadores_mes_total union all select cast(mes as varchar(50)) as mes, (cast(mes as varchar(50)) || '-Piso') as clave_mes, cast(clientes as bigint) as clientes, cast(venta_bruta as double precision) as venta_bruta, cast(trx as bigint) as trx, cast(unidades as double precision) as unidades, cast(venta_neta as double precision) as venta_neta, cast(margen as double precision) as margen, cast(gasto_prom as double precision) as gasto_prom, cast(frecuencia as double precision) as frecuencia, cast(tkp as double precision) as tkp, cast(unid_ticket as double precision) as unid_ticket, cast(precio_prom as double precision) as precio_prom, cast(margen_por as double precision) as margen_por, 'Piso' as canal from dl_sp_dashboards_ecommerce.prime_piso_indicadores_mes_total union all select cast(mes as varchar(50)) as mes, (cast(mes as varchar(50)) || '-Totales') as clave_mes, cast(clientes as bigint) as clientes, cast(venta_bruta as double precision) as venta_bruta, cast(trx as bigint) as trx, cast(unidades as double precision) as unidades, cast(venta_neta as double precision) as venta_neta, cast(margen as double precision) as margen, cast(gasto_prom as double precision) as gasto_prom, cast(frecuencia as double precision) as frecuencia, cast(tkp as double precision) as tkp, cast(unid_ticket as double precision) as unid_ticket, cast(precio_prom as double precision) as precio_prom, cast(margen_por as double precision) as margen_por, 'Totales' as canal from dl_sp_dashboards_ecommerce.prime_omnicanal_indicadores_mes_total", null, [EnableFolding=true])
				in
				    Origen

