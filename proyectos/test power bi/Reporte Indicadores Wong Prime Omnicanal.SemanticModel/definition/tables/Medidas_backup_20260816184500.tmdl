	measure VALOR_NO_PRIME_MES = ```
			
			SWITCH(
			    SELECTEDVALUE(Indicadores_no_prime[Etiqueta]),
			
			    // 1. Vta Neta (MM$)
			    "1- Vta Neta (MM$)", 
			        CALCULATE(
			                SUM(prime_indicadores_mes_grupos[venta_neta]), 
			                prime_indicadores_mes_grupos[grupo]="NO PRIME"
			            ), 
			            "#,0"
			        ),
			
			    // 2. % Part. Vta Prime/Wong
			    "2- % Part. Vta Prime/Wong",
			        VAR vtaNoPrime = CALCULATE(
			            SUM(prime_indicadores_mes_grupos[venta_neta]), 
			            prime_indicadores_mes_grupos[grupo]="NO PRIME"
			        )
			        VAR vtaTotal = SUM(prime_indicadores_mes_total[venta_neta])
			        RETURN IF(
			            NOT(ISBLANK(vtaTotal)),
			            FORMAT(DIVIDE(vtaNoPrime, vtaTotal),
			            BLANK()
			        ),
			
			    // 3. N Transacciones
			    "3- N Transacciones", 
			        CALCULATE(
			                SUM(prime_indicadores_mes_grupos[trx]), 
			                prime_indicadores_mes_grupos[grupo]="NO PRIME"
			            ),
			            "#,0"
			        ),
			
			    // 4. % Part. Trx Prime/Wong
			    "4- % Part. Trx Prime/Wong",
			        VAR trxNoPrime = CALCULATE(
			            SUM(prime_indicadores_mes_grupos[trx]), 
			            prime_indicadores_mes_grupos[grupo]="NO PRIME"
			        )
			        VAR trxTotal = SUM(prime_indicadores_mes_total[trx])
			        RETURN IF(
			            NOT(ISBLANK(trxTotal)),
			            FORMAT(DIVIDE(trxNoPrime, trxTotal),
			            BLANK()
			        ),
			
			    // 5. N Clientes
			    "5- N Clientes", 
			        CALCULATE(
			                SUM(prime_indicadores_mes_grupos[clientes]), 
			                prime_indicadores_mes_grupos[grupo]="NO PRIME"
			            ),
			            "#,0"
			        ),
			
			    // 6. % Part. Clientes Prime/Wong
			    "6- % Part. Clientes Prime/Wong",
			        VAR cliNoPrime = CALCULATE(
			            SUM(prime_indicadores_mes_grupos[clientes]), 
			            prime_indicadores_mes_grupos[grupo]="NO PRIME"
			        )
			        VAR cliTotal = cliNoPrime + CALCULATE(
			            SUM(prime_indicadores_mes_grupos[clientes]), 
			            prime_indicadores_mes_grupos[grupo]="PRIME"
			        )
			        RETURN IF(
			            NOT(ISBLANK(cliTotal)),
			            FORMAT(DIVIDE(cliNoPrime, cliTotal),
			            BLANK()
			        ),
			
			    // 7. Gasto Promedio Bruto
			    "7- Gasto Promedio Bruto", 
			        CALCULATE(
			                AVERAGE(prime_indicadores_mes_grupos[gasto_prom]), 
			                prime_indicadores_mes_grupos[grupo]="NO PRIME"
			            ),
			            "#,0"
			        ),
			
			    // 8. Frecuencia
			    "8- Frecuencia", 
			        FORMAT(
			            CALCULATE(
			                AVERAGE(prime_indicadores_mes_grupos[frecuencia]), 
			                prime_indicadores_mes_grupos[grupo]="NO PRIME"
			            ),
			            "#,0.00"
			        ),
			
			    // 9. Ticket Promedio Bruto
			    "9- Ticket Promedio Bruto", 
			        FORMAT(
			            CALCULATE(
			                AVERAGE(prime_indicadores_mes_grupos[tkp]), 
			                prime_indicadores_mes_grupos[grupo]="NO PRIME"
			            ),
			            "#,0"
			        ),
			
			    BLANK()
			)
			
			```
