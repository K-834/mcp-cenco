table Medidas
	lineageTag: f8f8d6e9-50c3-4519-aa98-cc022749d229

	measure VALOR_PRIME_MES = ```
			
			SWITCH(
			    SELECTEDVALUE(Indicadores_prime[Etiqueta]),
			
			    "1- Venta Neta", 
			        CALCULATE(SUM(prime_indicadores_mes_grupos[venta_neta]), prime_indicadores_mes_grupos[grupo]="PRIME"),"#,0"
			    ),
			
			    "2- %Part. Vta Prime/Wong",
			        VAR vtaPrime = CALCULATE(SUM(prime_indicadores_mes_grupos[venta_neta]), prime_indicadores_mes_grupos[grupo]="PRIME")
			        VAR vtaTotal = SUM(prime_indicadores_mes_total[venta_neta])
			        RETURN FORMAT(DIVIDE(vtaPrime, vtaTotal),
			
			    "3- Nº Transacciones", 
			        CALCULATE(SUM(prime_indicadores_mes_grupos[trx]), prime_indicadores_mes_grupos[grupo]="PRIME"   ),
			            "#,0"
			        ),
			
			    "4- %Part. Trx Prime/Wong",
			        VAR trxPrime = CALCULATE(SUM(prime_indicadores_mes_grupos[trx]), prime_indicadores_mes_grupos[grupo]="PRIME")
			        VAR trxTotal = SUM(prime_indicadores_mes_total[trx])
			        RETURN FORMAT(DIVIDE(trxPrime, trxTotal),
			
			    "5- Nº Clientes", 
			        CALCULATE(SUM(prime_indicadores_mes_grupos[clientes]), prime_indicadores_mes_grupos[grupo]="PRIME"   ),
			            "#,0"
			        ),
			
			    "6- %Part. Clientes Prime/Wong",
			        VAR cliPrime = CALCULATE(SUM(prime_indicadores_mes_grupos[clientes]), prime_indicadores_mes_grupos[grupo]="PRIME")
			        VAR cliTotal = CALCULATE(SUM(prime_indicadores_mes_grupos[clientes]), prime_indicadores_mes_grupos[grupo]="NO PRIME") + cliPrime
			        RETURN FORMAT(DIVIDE(cliPrime, cliTotal),
			
			    "7- Gasto Promedio Bruto", 
			        CALCULATE(AVERAGE(prime_indicadores_mes_grupos[gasto_prom]), prime_indicadores_mes_grupos[grupo]="PRIME"),
			
			
			  "8- Frecuencia",
			    CALCULATE(
			            AVERAGE(prime_indicadores_mes_grupos[frecuencia]),
			            prime_indicadores_mes_grupos[grupo] = "PRIME"
			        ),
			        "#,0.00"
			    ),
			
			    "9- Ticket Promedio Bruto", 
			      FORMAT(  CALCULATE(AVERAGE(prime_indicadores_mes_grupos[tkp]), prime_indicadores_mes_grupos[grupo]="PRIME"), "#,0"
			    ),
			
			     "9.1- Vta Neta Promocional (Punto Precio)", 
			    FORMAT(SUM(promocional_mes[venta_neta_promocional]),
			
			
			    "9.2- % Part. Vta Neta Promocional", 
			        VAR vtaPromo = SUM(promocional_mes[venta_neta_promocional])
			        VAR vtaNetaTotal = CALCULATE(SUM(prime_indicadores_mes_grupos[venta_neta]), prime_indicadores_mes_grupos[grupo]="PRIME")
			        RETURN DIVIDE(vtaPromo, vtaNetaTotal),
			
			    "9.3- Clientes Promocional",
			        SUM(promocional_mes[clientes_promocional]),
			
			    "9.4- % Clientes Promocional",
			        VAR cliPromo = SUM(promocional_mes[clientes_promocional])
			        VAR cliTotal2 = CALCULATE(SUM(prime_indicadores_mes_grupos[clientes]), prime_indicadores_mes_grupos[grupo]="PRIME")
			        RETURN DIVIDE(cliPromo, cliTotal2),
			
			    "9.5- Dscto Bruto Promocional",
			       SUM(promocional_mes[dsct_bruto_promocional])
			)
			
			```
		lineageTag: 7e7a594c-2b45-43b8-8a1d-54e53cbd6cf0

