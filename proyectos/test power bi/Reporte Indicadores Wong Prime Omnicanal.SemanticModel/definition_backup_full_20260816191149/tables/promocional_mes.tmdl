	partition promocional_mes = m
		mode: import
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("dl-prod.ctk5g1p1sube.us-east-1.redshift.amazonaws.com:5439","datalabs"), "select cast(mes as varchar(50)) as mes, (cast(mes as varchar(50)) || '-Ecommerce') as clave_mes, cast(dsct_bruto_promocional as double precision) as dsct_bruto_promocional, cast(clientes_promocional as bigint) as clientes_promocional, cast(venta_neta_promocional as double precision) as venta_neta_promocional, 'Ecommerce' as canal from dl_sp_temporal.promotion_mes union all select cast(mes as varchar(50)) as mes, (cast(mes as varchar(50)) || '-Piso') as clave_mes, cast(dsct_bruto_promocional as double precision) as dsct_bruto_promocional, cast(clientes as bigint) as clientes_promocional, cast(venta_neta_promocional as double precision) as venta_neta_promocional, 'Piso' as canal from dl_sp_dashboards_ecommerce.promocion_prime_piso_mes union all select cast(mes as varchar(50)) as mes, (cast(mes as varchar(50)) || '-Totales') as clave_mes, cast(dsct_bruto_promocional as double precision) as dsct_bruto_promocional, cast(clientes as bigint) as clientes_promocional, cast(venta_neta_promocional as double precision) as venta_neta_promocional, 'Totales' as canal from dl_sp_dashboards_ecommerce.promocion_prime_omnicanal_mes", null, [EnableFolding=true])
				in
				    Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

